{
  // Cloudflare Workers config: serves the built PWA and runs the sync relay.
  // Deployed by Workers Builds on every push to main (build: `pnpm build`,
  // deploy: `pnpm exec wrangler deploy`), or by hand with the same commands.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "footless",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only relay requests reach the Worker code; everything else is a static file.
    "run_worker_first": ["/relay/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RelayRoom" },
      { "name": "INVITES", "class_name": "InviteBox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["InviteBox"] }
  ],
  "observability": { "enabled": true },
  // Served at getwaroo.app. The old footless…workers.dev address keeps
  // working too: phones that installed the app from it still sync.
  "routes": [{ "pattern": "getwaroo.app", "custom_domain": true }],
  "workers_dev": true,
  // Push notifications. The private half is a secret: VAPID_PRIVATE_JWK
  // (make a pair with `node scripts/vapid.cjs`). Local dev uses .dev.vars.
  "vars": {
    "VAPID_PUBLIC_KEY": "BOfT-b4-qTJe5pExDG6K-_4fmKLpIwgpBASJwRzT0PypytmazN66MNZX25YkVIx3oMVMfJ_Zr3PkOy6Lsnc8szo",
    "VAPID_SUBJECT": "https://github.com/footless291/footless"
  }
}
