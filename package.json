{
  "name": "footless",
  "private": true,
  "description": "Split bills any way you like and settle up in bitcoin, without anyone holding your money.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @footless/web dev",
    "build": "pnpm --filter @footless/web build",
    "test": "pnpm -r test && node --test worker/*.test.ts",
    "typecheck": "pnpm -r typecheck && tsc -p worker",
    "relay": "wrangler dev --port 8787 --ip 127.0.0.1",
    "e2e": "node e2e/sync.cjs && node e2e/upgrade-and-tampering.cjs && node e2e/bitcoin.cjs && node e2e/scan-and-banners.cjs",
    "splash": "node scripts/splash.cjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "bolt11": "1.4.2",
    "playwright": "^1.63.0",
    "wrangler": "^4.165.0"
  }
}
